FROM electronuserland/builder:24

# Runtime libraries and a virtual display for checking Electron in the container.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth libgtk-3-0 libnss3 libasound2 libgbm1 libxss1 \
    libatk-bridge2.0-0 libdrm2 libx11-xcb1 xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /project
